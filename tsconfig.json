{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],
    "paths": {
      "src/*": ["./src/*"],
      "ink-picture": ["./src/ink-picture"],
      "ink-picture/*": ["./src/ink-picture/*"],
      "@ant/computer-use-mcp": ["./src/vendor/computer-use-mcp/index"],
      "@ant/computer-use-mcp/*": ["./src/vendor/computer-use-mcp/*"],
      "@ant/computer-use-input": ["./src/vendor/computer-use-mcp/input"],
      "@ant/computer-use-swift": ["./src/vendor/computer-use-mcp/swift"]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "scripts", "env.d.ts"],
  "exclude": ["**/src-tauri/target"]
}
