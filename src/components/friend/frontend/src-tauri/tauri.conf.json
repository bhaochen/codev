{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Codev Friend",
  "version": "0.1.0",
  "identifier": "com.codev.friend",
  "build": {
    "devUrl": "http://127.0.0.1:3456/friend/"
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Codev Friend",
        "label": "main",
        "url": "http://127.0.0.1:3456/friend/",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "width": 400,
        "height": 600,
        "minWidth": 200,
        "minHeight": 300,
        "resizable": true,
        "skipTaskbar": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
